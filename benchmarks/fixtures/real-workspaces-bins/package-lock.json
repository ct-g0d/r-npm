{
  "name": "real-workspaces-bins",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "real-workspaces-bins",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@real-ws/bin-consumer": {
      "resolved": "packages/bin-consumer",
      "link": true
    },
    "node_modules/@real-ws/bin-provider": {
      "resolved": "packages/bin-provider",
      "link": true
    },
    "node_modules/is-number": {
      "version": "7.0.0",
      "resolved": "https://registry.npmjs.org/is-number/-/is-number-7.0.0.tgz",
      "integrity": "sha512-41Cifkg6e8TylSpdtTpeLVMqvSBEVzTttHvERD741+pnZ8ANv0004MRL43QKPDlK9cGvNp6NZWZUBlbGXYxxng==",
      "license": "MIT",
      "engines": {
        "node": ">=0.12.0"
      }
    },
    "packages/bin-consumer": {
      "name": "@real-ws/bin-consumer",
      "version": "1.0.0",
      "dependencies": {
        "@real-ws/bin-provider": "*",
        "is-number": "^7.0.0"
      }
    },
    "packages/bin-provider": {
      "name": "@real-ws/bin-provider",
      "version": "1.0.0",
      "bin": {
        "ws-tool": "bin/ws-tool.js"
      }
    }
  }
}
